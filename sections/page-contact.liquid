<div class="page-contact section-padding" style="background-color: var(--color-background, #f9f6f0);">
  <div class="page-width">
    <!-- PAGE HEADER -->
    <header class="page-contact__header text-center">
      <span class="page-contact__tagline">We Are Here For You</span>
      <h1 class="page-contact__title">{{ page.title | default: 'Contact CHIC' }}</h1>
      <p class="page-contact__subtitle">{{ section.settings.subtitle | default: 'Whether you have questions about our Ayurvedic botanicals, need personalized skincare ritual guidance, or require assistance with an order, our specialists are dedicated to supporting your beauty journey.' }}</p>
    </header>

    <!-- MAIN CONTACT GRID -->
    <div class="page-contact__grid">
      
      <!-- LEFT COLUMN: CONTACT INFORMATION CARDS -->
      <div class="page-contact__info-column">
        <h2 class="page-contact__section-heading">Get In Touch</h2>
        <p class="page-contact__section-desc">Reach out through any of our support channels below. We take pride in offering mindful, attentive customer service.</p>
        
        <div class="contact-card-list">
          <!-- CALL -->
          <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}" class="contact-card">
            <div class="contact-card__icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="contact-card__content">
              <h3 class="contact-card__label">Call</h3>
              <p class="contact-card__value">{{ section.settings.phone }}</p>
            </div>
            <div class="contact-card__arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>

          <!-- WHATSAPP -->
          <a href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '-' | remove: '+' }}" target="_blank" rel="noopener noreferrer" class="contact-card">
            <div class="contact-card__icon-wrapper contact-card__icon-wrapper--whatsapp">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            <div class="contact-card__content">
              <h3 class="contact-card__label">WhatsApp</h3>
              <p class="contact-card__value">{{ section.settings.whatsapp }}</p>
            </div>
            <div class="contact-card__arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>

          <!-- SUPPORT HOURS -->
          <div class="contact-card contact-card--static">
            <div class="contact-card__icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="contact-card__content">
              <h3 class="contact-card__label">Customer Support Time</h3>
              <p class="contact-card__value">{{ section.settings.support_time }}</p>
            </div>
          </div>

          <!-- EMAIL -->
          <a href="mailto:{{ section.settings.email }}" class="contact-card">
            <div class="contact-card__icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contact-card__content">
              <h3 class="contact-card__label">Email</h3>
              <p class="contact-card__value">{{ section.settings.email }}</p>
            </div>
            <div class="contact-card__arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>

          <!-- ADDRESS -->
          <div class="contact-card contact-card--address contact-card--static">
            <div class="contact-card__icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div class="contact-card__content">
              <h3 class="contact-card__label">Address</h3>
              <p class="contact-card__value">{{ section.settings.address | newline_to_br }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: INTERACTIVE CONTACT FORM -->
      <div class="page-contact__form-column">
        <div class="contact-form-container">
          <h2 class="contact-form__heading">Send Us a Message</h2>
          <p class="contact-form__subtitle">Please fill out the form below and a member of our botanical care team will respond promptly.</p>

          {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="contact-form__message contact-form__message--success" tabindex="-1" autofocus>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>Thank you for contacting CHIC! We have received your message and will get back to you shortly.</span>
              </div>
            {%- elsif form.errors -%}
              <div class="contact-form__message contact-form__message--error" tabindex="-1" autofocus>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>Please check the errors below: {{ form.errors | default_errors }}</span>
              </div>
            {%- endif -%}

            <div class="contact-form__row">
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactForm-name">Your Name *</label>
                <input
                  class="contact-form__input"
                  autocomplete="name"
                  type="text"
                  id="ContactForm-name"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="e.g. Aditi Sharma"
                  required
                >
              </div>
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactForm-email">Email Address *</label>
                <input
                  class="contact-form__input"
                  autocomplete="email"
                  type="email"
                  id="ContactForm-email"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  placeholder="e.g. aditi@example.com"
                  required
                >
              </div>
            </div>

            <div class="contact-form__row">
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactForm-phone">Phone Number</label>
                <input
                  class="contact-form__input"
                  type="tel"
                  id="ContactForm-phone"
                  autocomplete="tel"
                  name="contact[phone]"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="+91 - 8878280711"
                >
              </div>
              <div class="contact-form__field">
                <label class="contact-form__label" for="ContactForm-subject">Subject / Order #</label>
                <input
                  class="contact-form__input"
                  type="text"
                  id="ContactForm-subject"
                  name="contact[subject]"
                  placeholder="Inquiry or Order #1234"
                >
              </div>
            </div>

            <div class="contact-form__field">
              <label class="contact-form__label" for="ContactForm-body">Your Message *</label>
              <textarea
                rows="6"
                id="ContactForm-body"
                class="contact-form__input contact-form__textarea"
                name="contact[body]"
                placeholder="How can we assist your botanical skincare ritual today?"
                required
              >
                {%- if form.body -%}{{ form.body }}{%- endif -%}
              </textarea>
            </div>

            <button type="submit" class="contact-form__submit button">
              <span>Send Message</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
          {%- endform -%}
        </div>
      </div>

    </div>

    <!-- BOTANICAL PHILOSOPHY BANNER -->
    <div class="page-contact__banner">
      <div class="page-contact__banner-inner">
        <h3 class="page-contact__banner-title">Our Commitment to Care</h3>
        <p class="page-contact__banner-text">Every customer inquiry is treated with the same meticulous care and precision as our botanical formulations. We strive to respond to all emails within 24 hours.</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     PAGE CONTACT STYLES - PREMIUM LUXURY BOTANICAL AESTHETIC
     ========================================================================== */
  .page-contact {
    padding: 6rem 0 8rem;
    color: var(--color-text, #333333);
  }
  
  /* Header */
  .page-contact__header {
    max-width: 750px;
    margin: 0 auto 5rem;
  }
  .page-contact__tagline {
    display: inline-block;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #8a967a; /* Sage Green */
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .page-contact__title {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: clamp(3rem, 5vw, 4.8rem);
    color: #2b4c3b; /* Deep Botanical Green */
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }
  .page-contact__subtitle {
    font-size: 1.6rem;
    line-height: 1.8;
    color: rgba(51, 51, 51, 0.8);
  }

  /* Grid Layout */
  .page-contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 4.5rem;
    align-items: start;
    margin-bottom: 6rem;
  }

  @media screen and (max-width: 991px) {
    .page-contact__grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  /* Left Column: Contact Cards */
  .page-contact__section-heading {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 2.6rem;
    color: #2b4c3b;
    margin-bottom: 1rem;
  }
  .page-contact__section-desc {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(51, 51, 51, 0.75);
    margin-bottom: 3rem;
  }

  .contact-card-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(138, 150, 122, 0.25);
    padding: 1.8rem 2.2rem;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  a.contact-card:hover {
    transform: translateY(-4px);
    background: #ffffff;
    border-color: #2b4c3b;
    box-shadow: 0 12px 25px rgba(43, 76, 59, 0.08);
  }

  .contact-card--static {
    cursor: default;
  }

  .contact-card--address {
    align-items: flex-start;
  }

  .contact-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(43, 76, 59, 0.08);
    color: #2b4c3b;
    flex-shrink: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  a.contact-card:hover .contact-card__icon-wrapper {
    background-color: #2b4c3b;
    color: #ffffff;
  }

  .contact-card__icon-wrapper--whatsapp {
    background-color: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

  a.contact-card:hover .contact-card__icon-wrapper--whatsapp {
    background-color: #25D366;
    color: #ffffff;
  }

  .contact-card__content {
    flex-grow: 1;
  }

  .contact-card__label {
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8a967a;
    margin-bottom: 0.3rem;
    font-weight: 600;
  }

  .contact-card__value {
    font-size: 1.55rem;
    color: #2b4c3b;
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
    word-break: break-word;
  }

  .contact-card__arrow {
    color: #8a967a;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  a.contact-card:hover .contact-card__arrow {
    transform: translateX(4px);
    color: #2b4c3b;
  }

  /* Right Column: Contact Form */
  .contact-form-container {
    background: #ffffff;
    border: 1px solid rgba(138, 150, 122, 0.3);
    padding: 3.5rem 4rem;
    border-radius: 6px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
  }

  @media screen and (max-width: 600px) {
    .contact-form-container {
      padding: 2.5rem 2rem;
    }
  }

  .contact-form__heading {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 2.6rem;
    color: #2b4c3b;
    margin-bottom: 0.8rem;
  }

  .contact-form__subtitle {
    font-size: 1.5rem;
    color: rgba(51, 51, 51, 0.75);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .contact-form__message {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.4rem 1.8rem;
    border-radius: 4px;
    margin-bottom: 2.5rem;
    font-size: 1.45rem;
    line-height: 1.5;
  }

  .contact-form__message--success {
    background-color: rgba(43, 76, 59, 0.1);
    border: 1px solid #2b4c3b;
    color: #2b4c3b;
  }

  .contact-form__message--error {
    background-color: rgba(220, 53, 69, 0.1);
    border: 1px solid #dc3545;
    color: #dc3545;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media screen and (max-width: 650px) {
    .contact-form__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .contact-form__field {
    margin-bottom: 2rem;
  }

  .contact-form__label {
    display: block;
    font-size: 1.35rem;
    font-weight: 500;
    color: #2b4c3b;
    margin-bottom: 0.8rem;
    letter-spacing: 0.03em;
  }

  .contact-form__input {
    width: 100%;
    padding: 1.3rem 1.6rem;
    font-size: 1.5rem;
    color: #333333;
    background-color: #fcfbf9;
    border: 1px solid rgba(138, 150, 122, 0.4);
    border-radius: 4px;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .contact-form__input:focus {
    outline: none;
    background-color: #ffffff;
    border-color: #2b4c3b;
    box-shadow: 0 0 0 3px rgba(43, 76, 59, 0.1);
  }

  .contact-form__input::placeholder {
    color: #aaaaaa;
    font-size: 1.4rem;
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    width: 100%;
    padding: 1.6rem 3rem;
    background-color: #2b4c3b;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: all 0.35s ease;
  }

  .contact-form__submit:hover {
    background-color: #1d3327;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(43, 76, 59, 0.2);
  }

  /* Botanical Philosophy Banner */
  .page-contact__banner {
    background: linear-gradient(135deg, #2b4c3b 0%, #1d3327 100%);
    color: #ffffff;
    padding: 4.5rem 3rem;
    border-radius: 6px;
    text-align: center;
    box-shadow: 0 15px 35px rgba(43, 76, 59, 0.15);
  }

  .page-contact__banner-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .page-contact__banner-title {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 2.6rem;
    color: #f9f6f0;
    margin-bottom: 1.2rem;
  }

  .page-contact__banner-text {
    font-size: 1.55rem;
    line-height: 1.8;
    color: rgba(249, 246, 240, 0.85);
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Page Subtitle",
      "default": "Whether you have questions about our Ayurvedic botanicals, need personalized skincare ritual guidance, or require assistance with an order, our specialists are dedicated to supporting your beauty journey."
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 - 8878280711"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp Number",
      "default": "+91 - 8878280711"
    },
    {
      "type": "text",
      "id": "support_time",
      "label": "Customer Support Time",
      "default": "24/7"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "chicthebotanicalbeauty@gmail.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "351 2/C Saket Nagar near\nBhimsen Joshi Parisar Complex,\nMadhya Pradesh,\nBhopal - 462024"
    }
  ]
}
{% endschema %}
